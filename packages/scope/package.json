{
  "name": "@batiste-aidk/scope",
  "version": "0.1.0",
  "description": "Path-based access control for Batiste MCP servers — glob deny-lists, depth caps, symbol-type filters; AST-level enforcement landing via @batiste-aidk/graph",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@batiste-aidk/core": "workspace:*",
    "@batiste-aidk/graph": "workspace:*",
    "micromatch": "4.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/micromatch": "4.0.10",
    "@types/node": "24.19.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
