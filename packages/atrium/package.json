{
  "name": "@batiste-aidk/atrium",
  "version": "0.1.0",
  "description": "Atrium — the entry hall to a Batiste deployment's Firm Memory. Ingestion (Claude Code memory + sessions, vault, Drive, Trello) and retrieval CLI. Every mutation is audit-emitted before commit per ADR-0002.",
  "type": "module",
  "bin": {
    "batiste-fm": "./bin/batiste-fm.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@batiste-aidk/audit": "workspace:*",
    "@batiste-aidk/memory": "workspace:*",
    "@batiste-aidk/parallel": "workspace:*",
    "ag-psd": "^30.1.1",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "ai",
    "mcp",
    "cli",
    "firm-memory",
    "ingestion",
    "rag",
    "batiste"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jardhel/batiste",
    "directory": "packages/atrium"
  }
}
