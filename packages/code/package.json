{
  "name": "@batiste-aidk/code",
  "version": "0.1.0",
  "description": "AI-powered code assistant MCP server - TDD, validation, dependency analysis, auto-fix",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "batiste-code": "./dist/cli.js",
    "batiste-direct": "./dist/direct-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/mcp/server.js",
    "test:node": "node --test test/manage-task.node.test.mjs"
  },
  "dependencies": {
    "@batiste-aidk/audit": "workspace:*",
    "@batiste-aidk/core": "workspace:*",
    "@batiste-aidk/graph": "workspace:*",
    "@batiste-aidk/gvs": "workspace:*",
    "fast-glob": "3.3.3",
    "ignore": "5.3.2",
    "micromatch": "4.0.8",
    "tree-sitter": "0.21.1",
    "tree-sitter-go": "0.21.2",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-rust": "0.21.0",
    "tree-sitter-typescript": "0.21.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/micromatch": "4.0.10",
    "@types/node": "24.19.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "ai",
    "mcp",
    "claude",
    "code",
    "tdd",
    "autofix"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jardhel/batiste",
    "directory": "packages/code"
  }
}
