# Endurecimento da cadeia de suprimento (SEV0, 2026-11-07). Ver docs/SECURITY.md.
# Dependencia nova entra com versao exata; nada de ^ ou ~ em package.json.
save-exact=true
# Integridade do store content-addressable verificada a cada instalacao (default true; explicito de proposito).
verify-store-integrity=true
# Instalar no CI/local nunca resolve fora do lockfile sem pedir.
prefer-frozen-lockfile=true
